    {
      "name": "04 \u2014 Destructive Cleanup (manual only)",
      "item": [
        {
          "name": "DELETE ALL local demo logs \u2014 CAREFUL",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/demo-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo-logs"
              ]
            },
            "description": "WARNING: This removes ALL rows in GenerationLog. No WHERE clause. Do not run collection-wide until you intentionally want to clear the logs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Deleted count exists\",()=>pm.expect(pm.response.json()).to.have.property(\"deleted_log_rows\"));"
                ]
              }
            }
          ]
        }
      ]
