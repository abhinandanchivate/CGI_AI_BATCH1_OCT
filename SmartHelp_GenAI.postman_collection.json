    {
      "name": "01 \u2014 Stochasticity / Temperature",
      "item": [
        {
          "name": "Temperature 0 - Laptop Welcome",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stochasticity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stochasticity"
              ]
            },
            "description": "Same prompt and run count. Compare variation across temperatures. Outputs are not guaranteed distinct.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Welcome a customer buying their first laptop.\",\n  \"temperature\": 0,\n  \"runs\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"expectedRuns\",3);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const data=pm.response.json();",
                  "pm.test(\"Output length matches runs\",()=>pm.expect(data.outputs).to.have.length(pm.variables.get(\"expectedRuns\")*1));",
                  "pm.test(\"Distinct count valid\",()=>pm.expect(data.distinct_outputs).to.be.within(0,data.runs));"
                ]
              }
            }
          ]
        },
